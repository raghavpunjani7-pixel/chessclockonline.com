---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { t, defaultLocale, locales, type Locale } from '../i18n/ui';

interface Props {
	page?: 'home' | 'clock' | 'timeControls' | 'features' | 'faq' | 'about' | 'privacy' | 'terms' | 'contact' | 'notFound' | 'serverError';
}

const { page = 'home' } = Astro.props;

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const dict = t(lang);

const titles: Record<NonNullable<Props['page']>, string> = {
	home: dict.meta.title,
	clock: dict.clockPage.metaTitle,
	timeControls: dict.timeControlsPage.metaTitle,
	features: dict.featuresPage.metaTitle,
	faq: dict.faqPage.metaTitle,
	about: dict.aboutPage.metaTitle,
	privacy: dict.privacyPage.metaTitle,
	terms: dict.termsPage.metaTitle,
	contact: dict.contactPage.metaTitle,
	notFound: dict.errorPage.notFoundMetaTitle,
	serverError: dict.errorPage.serverErrorMetaTitle,
};
const descriptions: Record<NonNullable<Props['page']>, string> = {
	home: dict.meta.description,
	clock: dict.clockPage.metaDescription,
	timeControls: dict.timeControlsPage.metaDescription,
	features: dict.featuresPage.metaDescription,
	faq: dict.faqPage.metaDescription,
	about: dict.aboutPage.metaDescription,
	privacy: dict.privacyPage.metaDescription,
	terms: dict.termsPage.metaDescription,
	contact: dict.contactPage.metaDescription,
	notFound: dict.errorPage.notFoundMetaDescription,
	serverError: dict.errorPage.serverErrorMetaDescription,
};
const title = titles[page];
const description = descriptions[page];
const noindex = page === 'notFound' || page === 'serverError';

// Strip the locale prefix (if any) to get the canonical, locale-independent path.
const pathname = Astro.url.pathname;
const prefix = lang !== defaultLocale ? `/${lang}` : '';
const currentPath = prefix && pathname.startsWith(prefix) ? pathname.slice(prefix.length) || '/' : pathname;

const canonicalURL = new URL(pathname, Astro.site);
const ogImageURL = new URL('/web-app-manifest-512x512.png', Astro.site);

const ogLocales: Record<Locale, string> = {
	en: 'en_US',
	es: 'es_ES',
	fr: 'fr_FR',
	de: 'de_DE',
	pt: 'pt_PT',
};
const ogLocale = ogLocales[lang];

const keywords = page === 'home' ? dict.meta.keywords : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="chess clock" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="theme-color" content="#171717" />

		{locales.map((locale) => (
			<link rel="alternate" hreflang={locale} href={new URL(locale === defaultLocale ? currentPath : `/${locale}${currentPath}`, Astro.site)} />
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(currentPath, Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Chess Clock Online" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

		<script async src="https://www.googletagmanager.com/gtag/js?id=G-VFFDY59YTN"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { dataLayer.push(arguments); }
			gtag("js", new Date());
			gtag("config", "G-VFFDY59YTN");
		</script>

		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("chessclockonline:theme");
					var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
					if (theme === "dark") document.documentElement.classList.add("dark");
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="min-h-screen bg-canvas-soft font-sans text-ink antialiased">
		<SiteHeader currentPath={currentPath} />
		<slot />
		<SiteFooter />
	</body>
</html>
