---
import { t } from '../i18n/ui';

const lang = Astro.currentLocale;
const dict = t(lang).chessClockFaq;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: dict.items.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.a,
		},
	})),
};
---

<section id="chess-clock-faq" class="bg-canvas-soft-2 py-10 scroll-mt-20">
	<div class="mx-auto max-w-3xl px-6">
		<h2 class="text-center text-display-sm text-ink sm:text-display-md">{dict.title}</h2>

		<div class="mt-8 divide-y divide-hairline rounded-lg border border-hairline bg-canvas card-shadow">
			{dict.items.map((faq) => (
				<details class="group p-6">
					<summary class="flex cursor-pointer list-none items-center justify-between text-body-md-strong text-ink">
						{faq.q}
						<span class="ml-3 text-mute transition-transform group-open:rotate-45">+</span>
					</summary>
					<p class="mt-3 text-body-sm text-body">{faq.a}</p>
				</details>
			))}
		</div>
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
