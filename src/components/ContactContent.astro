---
import { t } from '../i18n/ui';

const lang = Astro.currentLocale;
const dict = t(lang).contactPage;
---

<section class="bg-canvas py-10">
	<div class="mx-auto max-w-3xl px-6">
		<h1 class="text-display-sm text-ink sm:text-display-md">{dict.title}</h1>
		<p class="mt-4 text-body-md text-body">{dict.intro}</p>

		<div class="mt-8 rounded-lg border border-hairline bg-canvas card-shadow p-6">
			<p class="text-body-sm text-mute">{dict.emailLabel}</p>
			<a href={`mailto:${dict.email}`} class="mt-1 block text-body-md-strong text-ink hover:underline">{dict.email}</a>
			<p class="mt-4 text-body-sm text-body">{dict.responseNote}</p>
		</div>
	</div>
</section>
