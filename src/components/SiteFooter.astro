---
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

const lang = Astro.currentLocale;
const dict = t(lang);
const year = new Date().getFullYear();

const columns = [
	{
		title: dict.footer.timeControlsHeading,
		links: dict.timeControlsPage.items.map((item) => ({ href: localizedPath(lang, '/time-controls/'), label: item.name })),
	},
	{
		title: dict.footer.productHeading,
		links: [
			{ href: localizedPath(lang, '/clock/'), label: dict.footer.playNow },
			{ href: localizedPath(lang, '/features/'), label: dict.nav.features },
			{ href: localizedPath(lang, '/features/'), label: dict.footer.compare },
			{ href: localizedPath(lang, '/faq/'), label: dict.nav.faq },
		],
	},
];
---

<footer class="border-t border-hairline bg-canvas">
	<div class="mx-auto max-w-6xl px-6 py-16">
		<div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
			<div>
				<a href={localizedPath(lang, '/')} class="flex items-center gap-2 text-body-sm-strong text-ink">
					<img src="/favicon-96x96.png" alt="" width="28" height="28" class="h-7 w-7 rounded-sm" />
					Chess Clock Online
				</a>
				<p class="mt-3 max-w-sm text-body-sm text-body">{dict.footer.tagline}</p>
			</div>

			{columns.map((column) => (
				<div>
					<h3 class="text-caption text-mute uppercase tracking-wide">{column.title}</h3>
					<ul class="mt-3 space-y-2">
						{column.links.map((link) => (
							<li>
								<a href={link.href} class="text-body-sm text-body hover:text-ink">{link.label}</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="mt-12 border-t border-hairline pt-6 text-caption text-mute">
			<p>© {year} {dict.footer.copyright}</p>
		</div>
	</div>
</footer>
