---
import { t } from '../i18n/ui';

const lang = Astro.currentLocale;
const dict = t(lang).homeAbout;
---

<section class="bg-canvas py-10">
	<div class="mx-auto max-w-3xl px-6">
		<h2 class="text-display-sm text-ink sm:text-display-md">{dict.title}</h2>
		<p class="mt-4 text-body-md text-body">{dict.intro}</p>

		<div class="mt-8 space-y-6">
			{dict.sections.map((section) => (
				<div>
					<h3 class="text-body-md-strong text-ink">{section.heading}</h3>
					<p class="mt-2 text-body-md text-body">{section.body}</p>
				</div>
			))}
		</div>
	</div>
</section>
