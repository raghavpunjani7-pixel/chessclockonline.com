---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
const lang = Astro.currentLocale;
const dict = t(lang).nav;

const navLinks = [
	{ href: localizedPath(lang, '/clock/'), label: dict.play },
	{ href: localizedPath(lang, '/time-controls/'), label: dict.timeControls },
	{ href: localizedPath(lang, '/features/'), label: dict.features },
	{ href: localizedPath(lang, '/faq/'), label: dict.faq },
];
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/80 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-6">
		<a href={localizedPath(lang, '/')} class="flex items-center gap-2 whitespace-nowrap text-body-sm-strong text-ink">
			<img src="/favicon-96x96.png" alt="" width="28" height="28" class="h-7 w-7 shrink-0 rounded-sm" />
			Chess Clock Online
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class="whitespace-nowrap rounded-full px-3 py-2 text-body-sm text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink"
				>
					{link.label}
				</a>
			))}
		</nav>

		<div class="flex shrink-0 items-center gap-1">
			<LanguageSwitcher currentPath={currentPath} />
			<ThemeToggle />
			<a
				href={localizedPath(lang, '/clock/')}
				class="hidden shrink-0 whitespace-nowrap rounded-pill bg-primary px-3 py-2 text-button-md text-on-primary transition-opacity hover:opacity-90 sm:inline-block"
			>
				{dict.startClock}
			</a>
		</div>
	</div>
</header>
